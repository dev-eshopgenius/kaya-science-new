{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="highlights-section-wrap color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding page-width">
    {% if section.blocks.size != 0 %}
      <div class="icon-with-text-wrap">
        <div class="slideshow-container  {{ section.settings.classname }}">
          <div class="marqeeee">
            {% for i in (1..30) %}
              {%- for block in section.blocks -%}
                <div class="icon_text_loop">
                  <div class="icon_text_inner">
                    {% if block.settings.link != blank %}
                      <a href="{{ block.settings.link }}" class="icon_link">
                    {% endif %}
                    {% if block.settings.icon != blank %}
                      <div class="icon">
                        <img src="{{ block.settings.icon | img_url: 'original'}}">
                      </div>
                    {% endif %}
                    {% if block.settings['icon-text'] != blank %}
                      <div class="icon_text">{{ block.settings['icon-text'] }}</div>
                    {% endif %}
                    {% if block.settings.link != blank %}
                      </a>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

<style>
      :root {

      --m-size: clamp(10rem, 1rem + 40vmin, 30rem);
      --m-gap: calc(var(--m-size) / 14);
      --m-duration: 950s;
      --m-duration-quick: 90s;
      --m-duration-icon: 60s;
      --m-scroll-start: 0;
      --m-scroll-end: calc(-100% - var(--m-gap));
      --m-icon-size: clamp(6.25rem, 4.4498rem + 9.0009vw, 12.5rem);
    }

    .slideshow-container {
      display: flex;
      overflow: hidden;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
      gap: var(--m-gap);
      /* -webkit-mask-image: linear-gradient(
        var(--mask-direction, to right),
        hsl(0 0% 0% / 0),
        hsl(0 0% 0% / 1) 20%,
        hsl(0 0% 0% / 1) 80%,
        hsl(0 0% 0% / 0)
      );
      mask-image: linear-gradient(
        var(--mask-direction, to right),
        hsl(0 0% 0% / 0),
        hsl(0 0% 0% / 1) 20%,
        hsl(0 0% 0% / 1) 80%,
        hsl(0 0% 0% / 0)
      ); */
    }


    .marqeeee {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: space-around;
      /* gap: var(--m-gap); */
      gap: calc(var(--m-gap) + 20px);
      min-width: 100%;
      -webkit-animation: scroll-x var(--m-duration) linear infinite;
      animation: scroll-x var(--m-duration) linear infinite;
    }
    /* .marqeeee.quick {
      -webkit-animation: scroll-x var(--m-duration-quick) linear infinite;
      animation: scroll-x var(--m-duration-quick) linear infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .marqeeee {
        -webkit-animation-play-state: paused;
        animation-play-state: paused;
      }
    } */

    @-webkit-keyframes scroll-x {
      from {
        transform: translateX(var(--m-scroll-start));
      }
      to {
        transform: translateX(var(--m-scroll-end));
      }
    }

    @keyframes scroll-x {
      from {
        transform: translateX(var(--m-scroll-start));
      }
      to {
        transform: translateX(var(--m-scroll-end));
      }
    }
    .icon-with-text-wrap {
        display: flex;
        flex-direction: column;
        gap: var(--m-gap);
        margin: auto;
        max-width: 100vw;
    }

    .icon_text_loop:after {
      content: "";
      height: 50px;
      width: 2px;
      display: block;
      position: absolute;
      right: -18px;
      background: #262626;
      top: 0;
  }

  .icon_text_loop {
      position: relative;
  }

  .highlights-section-wrap .icon_text{
    line-height: 1;
  }
</style>
{% schema %}
{
  "name": "Move Text",
  "class": "hightlights-section section moving-text-1",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "classname",
      "label": "ClassName"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "icon-with-text",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "icon-text",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Move Text",
      "blocks": [
        {
          "type": "icon-with-text"
        }
      ]
    }
  ]
}
{% endschema %}
