{% if template.name == 'search' %}
{{ 'skin-quiz.css' | asset_url | stylesheet_tag: preload: true }}
<!-- Skin Quiz HTML Markup -->

<div class="skin-quiz__section-wrapper">
  <div class="page-width">
    <div class="skin-quiz__content-wrapper">
      <div class="skin-multiType__data-wrapper main-data-wrapper">
        <span>For</span>
        <div class="skin-type__content-wrapp selected-data-content">
          <div class="dropdown-heading">{{ section.settings.heading1 }}</div>
          <ul class="js_col_label skin-type-data type-data-content" style="display:none;">
            {% for i in (1..5) %}
              {% capture col_label %}col_label{{ i }}{% endcapture %}
              {% capture col_trigger %}col_trigger{{ i }}{% endcapture %}
              {% if section.settings[col_label] != blank %}
                <li
                  data-value="{{ section.settings[col_trigger] | handle }}"
                  data-group-name="{{ section.settings[col_label] }}"
                >
                  {{ section.settings[col_label] }}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>

      <div class="skin-productType__data-wrapper main-data-wrapper">
        <span>I'm looking for</span>
        <div class="product-type__content-wrapp selected-data-content">
          {% if section.settings.heading2 != blank %}
            <div class="dropdown-heading">{{ section.settings.heading2 }}</div>
          {% endif %}
          <ul id="product-type-select" class="js_col_list product-type-data type-data-content" style="display:none;">
            <li value="any-product" data-value="any-product" data-group="all">Any Product</li>
            {% for i in (1..5) %}
              {% capture col_listing %}col_list{{ i }}{% endcapture %}
              {% capture label_key %}col_trigger{{ i }}{% endcapture %}
              {% assign group_label = section.settings[label_key] | handle %}

              {% for collection in section.settings[col_listing] %}
                {% assign coll_obj = collections[collection.handle] %}
                {% if coll_obj %}
                  {% assign quiz_text = coll_obj.metafields.custom.skin_quiz_text.value %}
                  {% if quiz_text != blank %}
                    <li
                      value="{{ coll_obj.handle }}"
                      data-value="{{ quiz_text | handle }}"
                      data-group="{{ group_label }}"
                    >
                      {{ quiz_text }}
                    </li>
                  {% else %}
                    <li value="{{ coll_obj.handle }}" data-value="{{ coll_obj.handle }}" data-group="{{ group_label }}">
                      {{ coll_obj.title }}
                    </li>
                  {% endif %}
                {% endif %}
              {% endfor %}
            {% endfor %}
          </ul>
        </div>
      </div>

      <div class="skin-concern__data-wrapper main-data-wrapper">
        <span>that targets</span>
        <div class="concern-type__content-wrapp selected-data-content">
          <div class="dropdown-heading">{{ section.settings.heading3 }}</div>
          <ul
            id="product-concern-select"
            class="js_concern_list concern-type-data type-data-content"
            style="display:none;"
          ></ul>
        </div>
      </div>

      {% if template.name == 'search' %}<div class="button__wrapper">{% endif %}
      {% if section.settings.search_btn_label != blank %}
        <div class="search_btn_label_wrapp">
          <div class="button js-search-products ">{{ section.settings.search_btn_label }}</div>
        </div>
      {% endif %}
      {% if template.name == 'search' %}
        {% if section.settings.clear_btn_label != blank %}
          <div class="clear_btn_label_wrapp">
            <a class="button clear_btn_label" href="{{ section.settings.clear_url_label }}">
              {{- section.settings.clear_btn_label -}}
            </a>
          </div>
        {% endif %}
      {% endif %}
      {% if template.name == 'search' %}</div>{% endif %}
    </div>
  </div>
</div>

<script>

  
window.collectionDisplayNames = {
  {% for collection in collections %}
    "{{ collection.handle }}": "{{ collection.title | escape }}"{% unless forloop.last %},{% endunless %}
  {% endfor %}
};

window.collectionsProductsMetafields = {
  {%- for collection in collections -%}
    "{{ collection.handle }}": [
      {%- for product in collection.products -%}
        {
          id: "{{ product.id }}",
          title: "{{ product.title | escape }}",
          metafield: {{ product.metafields.custom.concern_filter.value | json }},
          tags: {{ product.tags | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
};



function getCookie(name) {
  const nameEQ = name + "=";
  const ca = document.cookie.split(';');
  for (let i = 0; i < ca.length; i++) {
    let c = ca[i];
    while (c.charAt(0) === ' ') c = c.substring(1, c.length);
    if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
  }
  return null;
}

function setCookie(name, value, days) {
  let expires = "";
  if (days) {
    const date = new Date();
    date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
    expires = "; expires=" + date.toUTCString();
  }
  document.cookie = name + "=" + (value || "") + expires + "; path=/";
}

document.addEventListener('DOMContentLoaded', () => {
  
  // Close button functionality (only once)
document.querySelectorAll('.close-overlay').forEach(closeBtn => {
  closeBtn.addEventListener('click', () => {
    document.body.classList.remove('dropdown-open');
    document.querySelectorAll('.type-data-content').forEach(el => {
      el.classList.remove('active');
      el.style.display = 'none';
    });
  });
});

//START:-  Close dropdown on clicking outside
document.addEventListener('click', (event) => {
  if (!event.target.closest('.main-data-wrapper')) {
    document.body.classList.remove('dropdown-open');
    document.querySelectorAll('.type-data-content').forEach(el => {
      el.classList.remove('active');
      el.style.display = 'none';
    });
  }
});
//END:-  Close dropdown on clicking outside

  if (typeof window.collectionsProductsMetafields === 'undefined' || Object.keys(window.collectionsProductsMetafields).length === 0) {
    console.error("Error: window.collectionsProductsMetafields is not defined or empty. Check Liquid generation.");
    return;
  }
  if (typeof window.collectionDisplayNames === 'undefined') {
    console.warn("Warning: window.collectionDisplayNames is not defined. Collection titles might not display correctly.");
  }


  const skinTypeSelect = document.querySelector(".js_col_label");
  const productTypeSelect = document.querySelector(".js_col_list");
  const concernSelect = document.getElementById("product-concern-select");
  const searchButton = document.querySelector('.js-search-products');

  const skin_dropdownHeading = document.querySelector('.skin-type__content-wrapp .dropdown-heading');
  const product_dropdownHeading = document.querySelector('.product-type__content-wrapp .dropdown-heading');
  const concern_dropdownHeading = document.querySelector('.concern-type__content-wrapp .dropdown-heading');

  let selectedMainCategory = getCookie('main_category') || "";
  let selectedProductFilter = getCookie('product_filter') || "";
  let selectedConcern = getCookie('concern_type') || "";

  const CATEGORY_MAP = {
    {% for i in (1..5) %}
      {% capture col_trigger_key %}col_trigger{{ i }}{% endcapture %}
      {% assign main_category_handle = section.settings[col_trigger_key] | handle %}

      {% if main_category_handle != blank %}
        "{{ main_category_handle }}": {
          subTags: [
            {% capture tags_list_key %}col_tags{{ i }}{% endcapture %}
            {% assign tags_array = section.settings[tags_list_key] | split: ',' | compact %}
            {% for tag in tags_array %}
              "{{ tag | strip | handle }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          collections: [
            {% capture col_listing_key %}col_list{{ i }}{% endcapture %}
            {% for collection in section.settings[col_listing_key] %}
              "{{ collection.handle }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }{% unless forloop.last %},{% endunless %}
      {% endif %}
    {% endfor %}
  };



  function filterProductTypeList() {
    const allProductTypeLis = productTypeSelect.querySelectorAll('li');
    let anyProductFound = false;

    allProductTypeLis.forEach(li => {
      const group = li.getAttribute('data-group');
      const value = li.getAttribute('value');

      if (value === 'any-product') {
        li.style.display = 'block';
        anyProductFound = true;
      } else if (selectedMainCategory && group === selectedMainCategory) {
        const currentCollectionHandle = value;
        const productsInSelectedMainCategoryCollections = [];
        if (CATEGORY_MAP[selectedMainCategory] && CATEGORY_MAP[selectedMainCategory].collections) {
            CATEGORY_MAP[selectedMainCategory].collections.forEach(colHandle => {
                if (window.collectionsProductsMetafields[colHandle]) {
                    productsInSelectedMainCategoryCollections.push(...window.collectionsProductsMetafields[colHandle]);
                }
            });
        }
        
        const productsInCurrentCollection = window.collectionsProductsMetafields[currentCollectionHandle] || [];
        const hasRelevantProducts = productsInCurrentCollection.some(currentColProd => 
            productsInSelectedMainCategoryCollections.some(mainCatProd => mainCatProd.id === currentColProd.id)
        );

        if (hasRelevantProducts) {
            li.style.display = 'block';
        } else {
            li.style.display = 'none';
        }

      } else {
        li.style.display = 'none';
      }
    });

    const currentProductLi = productTypeSelect.querySelector(`li[value="${selectedProductFilter}"]`);
    if (!currentProductLi || currentProductLi.style.display === 'none') {
        selectedProductFilter = 'any-product';
        setCookie('product_filter', selectedProductFilter, 1);
        product_dropdownHeading.innerText = 'Any Product';
        allProductTypeLis.forEach(li => li.classList.remove('active'));
        productTypeSelect.querySelector('li[value="any-product"]').classList.add('active');
    } else {
        product_dropdownHeading.innerText = currentProductLi.innerText;
        allProductTypeLis.forEach(li => li.classList.remove('active'));
        currentProductLi.classList.add('active');
    }
  }


  function populateConcernTypes() {
    concernSelect.innerHTML = '';
    const concernsSet = new Set();
    concernsSet.add('any-concern');

    let productsToConsider = [];

    const productsInSelectedMainCategoryCollections = [];
    if (selectedMainCategory && CATEGORY_MAP[selectedMainCategory]) {
        CATEGORY_MAP[selectedMainCategory].collections.forEach(colHandle => {
            if (window.collectionsProductsMetafields[colHandle]) {
                productsInSelectedMainCategoryCollections.push(...window.collectionsProductsMetafields[colHandle]);
            }
        });
    } else {
        Object.values(window.collectionsProductsMetafields).forEach(colProducts => {
            productsInSelectedMainCategoryCollections.push(...colProducts);
        });
    }

    if (selectedProductFilter && selectedProductFilter !== 'any-product') {
        const productsInSelectedProductTypeCollection = window.collectionsProductsMetafields[selectedProductFilter] || [];
        productsToConsider = productsInSelectedMainCategoryCollections.filter(mainCatProd => 
            productsInSelectedProductTypeCollection.some(prodInCol => prodInCol.id === mainCatProd.id)
        );
    } else {
        productsToConsider = productsInSelectedMainCategoryCollections;
    }


    productsToConsider.forEach(prod => {
      const meta = prod.metafield;
      if (Array.isArray(meta)) meta.forEach(val => concernsSet.add(val.trim()));
      else if (typeof meta === "string") concernsSet.add(meta.trim());
      else if (typeof meta === "object" && meta !== null) Object.values(meta).forEach(val => concernsSet.add(val.trim()));
    });

    const sortedConcerns = Array.from(concernsSet).sort((a,b) => {
        if (a === 'any-concern') return -1;
        if (b === 'any-concern') return 1;
        return a.localeCompare(b);
    });

    sortedConcerns.forEach(concern => {
      const li = document.createElement("li");
      li.setAttribute("value", concern);
      li.textContent = (concern === 'any-concern') ? 'Any Concern' : concern.replace(/-/g, ' ').replace(/\b\w/g, char => char.toUpperCase());
      concernSelect.appendChild(li);
    });

    if (!selectedConcern || !concernsSet.has(selectedConcern)) {
        selectedConcern = 'any-concern';
    }
    const currentConcernOptionLi = concernSelect.querySelector(`li[value="${selectedConcern}"]`);
    if (currentConcernOptionLi) {
        currentConcernOptionLi.classList.add('active');
        concern_dropdownHeading.innerText = currentConcernOptionLi.innerText;
        console.log('selectedConcern<><>', selectedConcern);
        setCookie('concern_type', selectedConcern, 1);
    }
  }


  function handleDropdown(dropdownHeadingSelector) {
    const dropdownHeading = document.querySelector(dropdownHeadingSelector);
    if (!dropdownHeading) return;

    dropdownHeading.addEventListener('click', (e) => {
      e.stopPropagation();
      const dropdown = dropdownHeading.nextElementSibling;
      if (!dropdown) return;

      document.querySelectorAll('.type-data-content').forEach(el => {
        if (el !== dropdown) {
          el.classList.remove('active');
          el.style.display = 'none';
        }
      });

      const isActive = dropdown.classList.toggle('active');
      dropdown.style.display = isActive ? 'block' : 'none';

      if (isActive) {
        document.body.classList.add('dropdown-open');
        const closeOverlayButton = document.querySelector('.quiz-overlay .close-overlay');
        if (closeOverlayButton) {
            closeOverlayButton.style.bottom = (dropdown.offsetHeight - 8) + 'px';
        }
      } else {
        document.body.classList.remove('dropdown-open');
      }
    });
  }

  handleDropdown('.skin-type__content-wrapp .dropdown-heading');
  handleDropdown('.product-type__content-wrapp .dropdown-heading');
  handleDropdown('.concern-type__content-wrapp .dropdown-heading');

  document.addEventListener('click', (event) => {
    if (!event.target.closest('.main-data-wrapper')) {
      document.body.classList.remove('dropdown-open');
      document.querySelectorAll('.type-data-content').forEach(el => {
        el.classList.remove('active');
        el.style.display = 'none';
      });
    }
  });

  skinTypeSelect.addEventListener("click", function (e) {
    if (e.target.tagName === "LI") {
      const clickedValue = e.target.getAttribute("data-value");
      const clickedText = e.target.innerText;

      selectedMainCategory = clickedValue;
      setCookie('main_category', selectedMainCategory, 1);

      this.querySelectorAll("li").forEach(li => li.classList.remove("active"));
      e.target.classList.add("active");
      skin_dropdownHeading.innerText = clickedText;
      skin_dropdownHeading.nextElementSibling.style.display = 'none';
      skin_dropdownHeading.nextElementSibling.classList.remove('active');
      document.body.classList.remove('dropdown-open');

      selectedProductFilter = 'any-product';
      selectedConcern = 'any-concern';
      setCookie('product_filter', selectedProductFilter, 1);
      setCookie('concern_type', selectedConcern, 1);

      filterProductTypeList();
      populateConcernTypes();
    }
  });

  productTypeSelect.addEventListener("click", function (e) {
    if (e.target.tagName === "LI") {
      const clickedValue = e.target.getAttribute("value"); 
      selectedProductFilter = clickedValue;
      setCookie('product_filter', selectedProductFilter, 1);

      this.querySelectorAll("li").forEach(li => li.classList.remove("active"));
      e.target.classList.add("active");
      product_dropdownHeading.innerText = e.target.innerText;
      product_dropdownHeading.nextElementSibling.style.display = 'none';
      product_dropdownHeading.nextElementSibling.classList.remove('active');
      document.body.classList.remove('dropdown-open');

      selectedConcern = 'any-concern';
      setCookie('concern_type', selectedConcern, 1);

      populateConcernTypes();
    }
  });

  concernSelect.addEventListener("click", function (e) {
    if (e.target.tagName === "LI") {
      selectedConcern = e.target.getAttribute("value");
      setCookie('concern_type', selectedConcern, 1);

      this.querySelectorAll("li").forEach(li => li.classList.remove("active"));
      e.target.classList.add("active");
      concern_dropdownHeading.innerText = e.target.innerText;
      concern_dropdownHeading.nextElementSibling.style.display = 'none';
      concern_dropdownHeading.nextElementSibling.classList.remove('active');
      document.body.classList.remove('dropdown-open');
    }
  });



searchButton.addEventListener('click', () => {
  let baseUrl = '/search';
  let queryParams = [];
  let query = '';
  let view = '&view=quiz-products';

  // Case 1: Concern selected
  if (selectedConcern && selectedConcern !== "any-concern") {
    query = (selectedProductFilter && selectedProductFilter !== 'any-product')
      ? selectedProductFilter
      : selectedMainCategory;

    queryParams.push(`q=${encodeURIComponent(query).replace('-','+')}`);
    queryParams.push('type=product');
     queryParams.push('options[prefix]=last');
    queryParams.push(`filter.p.m.custom.concern_filter=${encodeURIComponent(selectedConcern)}`);
  }

  // Case 2: Only product filter selected
  else if (selectedProductFilter && selectedProductFilter !== 'any-product') {
  query = `${selectedProductFilter.trim()}`;
    queryParams.push(`q=${encodeURIComponent(query).replace('-','+')}`);
    queryParams.push('type=product');
    queryParams.push('options[prefix]=last');
  }

  // Case 3: Only main category selected
  else if (selectedMainCategory && selectedMainCategory !== 'any-product') {
    query = selectedMainCategory;
    queryParams.push(`q=${encodeURIComponent(query)}`);
    queryParams.push('type=product');
  }

  // Final URL
  if (queryParams.length > 0) {
    window.location.href = `${baseUrl}?${queryParams.join('&')}${view}`;
  } else {
    window.location.href = '/collections/all';
  }
});


  selectedMainCategory = getCookie('main_category') || "";
  selectedProductFilter = getCookie('product_filter') || "";
  selectedConcern = getCookie('concern_type') || "";

  const initialMainCategoryLi = skinTypeSelect.querySelector(`li[data-value="${selectedMainCategory}"]`);
  if (initialMainCategoryLi) {
    skin_dropdownHeading.innerText = initialMainCategoryLi.innerText;
    skinTypeSelect.querySelectorAll('li').forEach(li => li.classList.remove('active'));
    initialMainCategoryLi.classList.add('active');
  } else {
    const firstMainCategoryLi = skinTypeSelect.querySelector('li');
    if (firstMainCategoryLi) {
      firstMainCategoryLi.classList.add('active');
      skin_dropdownHeading.innerText = firstMainCategoryLi.innerText;
      selectedMainCategory = firstMainCategoryLi.getAttribute('data-value');
      setCookie('main_category', selectedMainCategory, 1);
    } else {
        skin_dropdownHeading.innerText = "My Face";
    }
  }

  filterProductTypeList();
  populateConcernTypes();


console.log('selectedMainCategory:----', selectedMainCategory);
console.log('CATEGORY_MAP:-----', CATEGORY_MAP);
//console.log('collectionsProductsMetafields:----', window.collectionsProductsMetafields);
//console.log('productsInSelectedMainCategoryCollections:----', productsInSelectedMainCategoryCollections);
//console.log('productsInCurrentCollection:-----', productsInCurrentCollection);

});
</script>
{% endif %}
