                  <path d="M17.2222 14.2691C17.2222 14.5299 17.0108 14.7413 16.75 14.7413C16.4892 14.7413 16.2778 14.5299 16.2778 14.2691C16.2778 14.0083 16.4892 13.7968 16.75 13.7968C17.0108 13.7968 17.2222 14.0083 17.2222 14.2691Z" fill="url(#paint1_linear_6268_14697)"/>
