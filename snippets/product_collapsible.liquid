{% if product.metafields.custom.product_collapsible != blank %}
  <div class="product_collapsile--wrap">
    <div class="product_collapsile--main">
      <div class="product_collapsile--items product__accordion-wrapper">
        {% for product_collapsible in product.metafields.custom.product_collapsible.value %}
          <div class="product_collapsile--item">
             <details
                  id="Details-{{ block.id }}-{{ section.id }}"
                  {% if section.settings.open_first_collapsible_row and forloop.first %}
                    open
                  {% endif %}
                >
                <summary id="Summary-{{ block.id }}-{{ section.id }}">
                  {% render 'icon-accordion', icon: block.settings.icon %}
                    <h3 class="accordion__title inline-richtext h4">
                    <div class="accordion_heading">
                      <span class="acc-heading">{{ product_collapsible.heading }}</span>
                      {% unless product_collapsible.default_show -%}
                        <span>{% render 'icon-prod-accordion' %}</span>
                      {%- endunless %}
                    </div>
                  </h3>
                </summary>
           <div
                    class="accordion__content rte"
                    id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
                    role="region"
                    aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
                  >
              {{ product_collapsible.text | metafield_tag }}
            </div>
                </details>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

