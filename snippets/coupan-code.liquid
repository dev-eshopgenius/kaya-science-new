<div class="product--offers-wraper">
  {% if block.settings.offertitle != blank %}
    <div class="title coupanCode--title">
      {{ block.settings.offertitle }}
    </div>
  {% endif %}

  <div class="product--offers-wrap vvv">
    <div class="coupan-code-wrapper">
      <div class="coupan-code-content">
        <ul>
          {% for block in section.blocks %}
            {% if block.type == 'product__offers' %}
              {% for i in (i..6) %}
                {% capture heading %}heading{{ i }}{% endcapture %}
                {% capture subheading %}subheading{{ i }}{% endcapture %}
                {% assign has_b2g2_sale = false %}
                {% for item in cart.items %}
                  {% if item.product.tags contains 'navratri-sale' %}
                    {% assign has_b2g2_sale = true %}
                  {% endif %}
                {% endfor %}
                {% if block.settings[heading] != blank or block.settings[subheading] != blank %}
                  <li class="code--items {% if collection.handle == "festive-glow-sale-buy-2-get-2" %}{% unless firs_item %} hide_all{% endunless %}{% endif %}{% if has_b2g2_sale %}{% if i == 3 or i == 4 %} hide_b2g2_sale{% endif %}{% endif %}">
                    <div class="content-wrapp">
                      {% if block.settings[heading] != blank %}
                        <div class="heading">{{ block.settings[heading] }}</div>
                      {% endif %}
                      {% if block.settings[subheading] != blank %}
                        <div class="sub_heading discount-code-item">
                          <div class="discountcode textToCopy">{{ block.settings[subheading] }}</div>
                          {% unless block.settings[subheading] == 'AUTO-APPLIED' %}
                            <button
                              class="copy-btn"
                              data-code="{{ block.settings[subheading] }}"
                              onclick="navigator.clipboard.writeText(this.getAttribute('data-code')).then(() => { this.innerText = 'Copied!'; setTimeout(() => { this.innerText = 'Copy'; }, 2000); })"
                            >
                              Copy
                            </button>
                          {% endunless %}
                        </div>
                      {% endif %}
                    </div>
                  </li>
                  {% comment %}

                    {% if i == 1 %}
                      <li class="code--items {{ has_b2g2_sale }}">
                        <div class="content-wrapp">
                          {% if block.settings[heading] != blank %}
                            <div class="heading">{{ block.settings[heading] }}</div>
                          {% endif %}
                          {% if block.settings[subheading] != blank %}
                            <div class="sub_heading discount-code-item">
                              <div class="discountcode textToCopy">{{ block.settings[subheading] }}</div>
                              {% unless block.settings[subheading] == 'AUTO-APPLIED' %}
                                <button
                                  class="copy-btn"
                                  data-code="{{ block.settings[subheading] }}"
                                  onclick="navigator.clipboard.writeText(this.getAttribute('data-code')).then(() => { this.innerText = 'Copied!'; setTimeout(() => { this.innerText = 'Copy'; }, 2000); })"
                                >
                                  Copy
                                </button>
                              {% endunless %}
                            </div>
                          {% endif %}
                        </div>
                      </li>
                    {% elsif i == 4 %}
                      {% if product.tags contains 'summer-sale' %}
                        <li class="code--items ">
                          <div class="content-wrapp">
                            {% if block.settings[heading] != blank %}
                              <div class="heading">{{ block.settings[heading] }}</div>
                            {% endif %}
                            {% if block.settings[subheading] != blank %}
                              <div class="sub_heading discount-code-item">
                                <div class="discountcode textToCopy">{{ block.settings[subheading] }}</div>
                                {% unless block.settings[subheading] == 'AUTO-APPLIED' %}
                                  <button
                                    class="copy-btn"
                                    data-code="{{ block.settings[subheading] }}"
                                    onclick="navigator.clipboard.writeText(this.getAttribute('data-code')).then(() => { this.innerText = 'Copied!'; setTimeout(() => { this.innerText = 'Copy'; }, 2000); })"
                                  >
                                    Copy
                                  </button>
                                {% endunless %}
                              </div>
                            {% endif %}
                          </div>
                        </li>
                      {% endif %}
                    {% elsif i == 3 %}
                      {% comment %} {% if product.tags contains 'MonsoonSale' %}  {% endcomment %}
                      <li class="code--items gg">
                        <div class="content-wrapp">
                          {% if block.settings[heading] != blank %}
                            <div class="heading">{{ block.settings[heading] }}</div>
                          {% endif %}
                          {% if block.settings[subheading] != blank %}
                            <div class="sub_heading discount-code-item">
                              <div class="discountcode textToCopy">{{ block.settings[subheading] }}</div>
                              {% unless block.settings[subheading] == 'AUTO-APPLIED' %}
                                <button
                                  class="copy-btn"
                                  data-code="{{ block.settings[subheading] }}"
                                  onclick="navigator.clipboard.writeText(this.getAttribute('data-code')).then(() => { this.innerText = 'Copied!'; setTimeout(() => { this.innerText = 'Copy'; }, 2000); })"
                                >
                                  Copy
                                </button>
                              {% endunless %}
                            </div>
                          {% endif %}
                        </div>
                      </li>
                      {% comment %} {% endif %} {% endcomment %}
                    {% else %}
                      <li class="code--items {{ has_b2g2_sale }}">
                        <div class="content-wrapp">
                          {% if block.settings[heading] != blank %}
                            <div class="heading">{{ block.settings[heading] }}</div>
                          {% endif %}
                          {% if block.settings[subheading] != blank %}
                            <div class="sub_heading discount-code-item">
                              <div class="discountcode textToCopy">{{ block.settings[subheading] }}</div>
                              {% unless block.settings[subheading] == 'AUTO-APPLIED' %}
                                <button
                                  class="copy-btn"
                                  data-code="{{ block.settings[subheading] }}"
                                  onclick="navigator.clipboard.writeText(this.getAttribute('data-code')).then(() => { this.innerText = 'Copied!'; setTimeout(() => { this.innerText = 'Copy'; }, 2000); })"
                                >
                                  Copy
                                </button>
                              {% endunless %}
                            </div>
                          {% endif %}
                        </div>
                      </li>
                    {% endif %}
                  {% endcomment %}
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</div>
