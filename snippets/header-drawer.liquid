                                gradientUnits="userSpaceOnUse">
                                <stop stop-color="#DDEDEB" stop-opacity="0" ></stop>
                                <stop offset="1" stop-color="#DDEDEB" ></stop>
                            </linearGradient>
                        </defs>
                    </svg>
                        <span>{{ block.settings.cont_heading }}</span>
                      </div>
                      <div class="contact_btn">
                        {% if block.settings.con_btn_link != blank %}
                          <a href="{{ block.settings.con_btn_link }}" class="cont_btn-link">
                            {{ block.settings.con_btn_label }}
                          </a>
                        {% endif %}
                      </div>
                    </li>
                  {% endif %}
                  {% if block.settings.chat_heading != blank %}
                    <li class="free_shipping--item">
                      <div class="chat__heading drawer-box">
                          
