{% comment %}
  Renders a header drawer menu for mobile and desktop.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}
{% style %}
  span.svg-wrapper.expanded svg {
    transform: rotate(90deg);
}
{% endstyle %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset header__ham--summary"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        <!-- {{- 'icon-close.svg' | inline_asset_content -}} -->
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
         <div class="menu-drawer__inner-container">
          <div class="header__icons header-icon__mobile">
  {% for icon in (1..3) %}
    {% assign link_key = "icon_" | append: icon | append: "_link" %}
    {% assign image_key = "icon_" | append: icon | append: "_image" %}
    {% assign link = section.settings[link_key] %}
    {% assign image = section.settings[image_key] %}
    
    {% if link and image %}
      <a href="{{ link }}" class="header__icon-link">
        <img src="{{ image | img_url: '600x600' }}" alt="Icon {{ icon }}" class="header__icon-image" />
      </a>
    {% endif %}
  {% endfor %}
</div>        
        <div class="menu-drawer__navigation-container">
          {% if section.settings.mob_dra_navimage != blank %}
          <div class="mob_dra_navimage">
            <!-- <button id="open-react-app" class="open-react-app"> -->
            <a href="https://kayascience.com/pages/skin-analyzer">
             {{ section.settings.mob_dra_navimage | image_url: width: section.settings.mob_dra_navimage.width, height:section.settings.mob_dra_navimage.height | image_tag: loading:'lazy' , class:'mob_nav_img' }}
           </a>
            
            <!-- </button> -->
            </div>
          {% endif %}
          <nav class="menu-drawer__navigation">
            <ul class="menu-drawer__menu has-submenu list-menu on_click-menu" role="list">
              {% for block in section.blocks %}
                {% if block.type == 'mobile_menu' %}

                  {% render 'mobile-header-drawer',block:block %}
                  {% if block.settings.cont_heading != blank %}
                    <li class="free_shipping--item">
                      <div class="cont_heading drawer-box">
