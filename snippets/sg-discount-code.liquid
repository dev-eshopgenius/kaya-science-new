<script>
  let TIMEOUT_VAR;

  document.addEventListener("DOMContentLoaded", () => {
    initializeDiscountWidget("cart");

    const cartDrawer = document.querySelector("cart-drawer");
    if (cartDrawer) {
      const observer = new MutationObserver(() => {
        if (cartDrawer.classList.contains("active")) {
          clearTimeout(TIMEOUT_VAR);
          initializeDiscountWidget("drawer");
        }
      });
      observer.observe(cartDrawer, { attributes: true, attributeFilter: ["class"] });
    }

    document.addEventListener("click", (event) => {
      const button = event.target.closest("#copy-code-btn");
      if (!button) return;

      const discountCodeElement = document.querySelector(".dw_code");
      if (!discountCodeElement) return;

      const code = discountCodeElement.innerText.trim();
      navigator.clipboard.writeText(code).then(() => {
        button.textContent = "Copied";
        setTimeout(() => (button.textContent = "Copy"), 1000);
      }).catch(err => console.error("Clipboard copy failed:", err));
    });
  });

  function initializeDiscountWidget(type = "drawer") {
    const APP_DOMAIN = "https://kaya-science-discount-e0fa68da8cdb.herokuapp.com";
    const API_URL = `${APP_DOMAIN}/api/get-code`;
    const COOKIE_NAME = "discount_timer";
    const DISCOUNT_COOKIE = "discount_code_cus";
    const DISCOUNT_EXPIRE = "discount_code_expire";
    const ACTIVE_COOKIE = "discount_active";
    const TIMER_DURATION = 15 * 60;
    const ACTIVE_DURATION = 12 * 60 * 60;
    const EXPIRE_DURATION = 24 * 60 * 60;

    let discountCode = getCookie(DISCOUNT_COOKIE);
    let remainingTime = parseInt(getCookie(COOKIE_NAME), 10) || TIMER_DURATION;

    if (discountCode) {
      renderWidgetUnified(type, discountCode, remainingTime);
    } else {
      fetchDiscountCode();
    }

    async function fetchDiscountCode() {
      try {
        const response = await fetch(API_URL);
        const data = await response.json();
        if (data.success && data.data.code) {
          discountCode = data.data.code;
          setCookie(DISCOUNT_COOKIE, discountCode, TIMER_DURATION);
          setCookie(COOKIE_NAME, TIMER_DURATION, TIMER_DURATION);
          renderWidgetUnified(type, discountCode, TIMER_DURATION);
        }
      } catch (error) {
        console.error("Failed to fetch discount code:", error);
      }
    }

    function renderWidgetUnified(type, code, timeLeft) {
      const selector = type === "cart"
        ? ".discount-widget-container--cart"
        : ".discount-widget-container--drawer";
      const container = document.querySelector(selector);
      if (!container) return;

      container.querySelectorAll(".discount-widget").forEach(el => el.remove());

      const widgetHTML = `
        <div class="discount-widget" id="discount-widget">
          <div class="dw_wrap">
            <div class="dw_info">
              <div class="dw_title">Limited Time Offer!</div>
              <div class="dw_desc">Use code to avail 5% off on entire cart value</div>
            </div>
            <div class="dw_inwrp">
              <div class="dwcode_wrap">
                <div class="dw_code">${code}</div>
                <button id="copy-code-btn" class="dw_copy button">Copy</button>
              </div>
              <div id="timer-text" class="dw_timertext">
                <div class="dw_cdtwrap">
                  <strong>Offer Expires in: <span class="countdown" id="countdown">${formatTime(timeLeft)}</span> ⏱️</strong>
                </div>
                <div class="dw_desc_2"><strong>Flat 5% off</strong> on orders above ₹1399.00</div>
              </div>
            </div>
          </div>
        </div>
      `;

      if (getCookie(ACTIVE_COOKIE) === "true") {
        container.innerHTML = widgetHTML;
        startCountdown(timeLeft, container);
      } else {
        setTimeout(() => {
          container.innerHTML = widgetHTML;
          document.body.classList.add("discount_show");
          setCookie(ACTIVE_COOKIE, "true", ACTIVE_DURATION);

          TIMEOUT_VAR = setTimeout(() => {
            document.body.classList.remove("discount_show");
          }, 2000);

          startCountdown(timeLeft, container);
        }, 10000);
      }
    }

    function startCountdown(seconds, container) {
      const countdownEl = container.querySelector(".countdown");
      if (!countdownEl) return;

      const interval = setInterval(() => {
        seconds--;
        countdownEl.textContent = formatTime(seconds);
        setCookie(COOKIE_NAME, seconds, seconds);

        if (seconds <= 0) {
          clearInterval(interval);
          [COOKIE_NAME, DISCOUNT_COOKIE, ACTIVE_COOKIE].forEach(deleteCookie);
          container.querySelectorAll(".discount-widget").forEach(el => el.remove());
          setCookie(DISCOUNT_EXPIRE, "true", EXPIRE_DURATION);
        }
      }, 1000);
    }

    function formatTime(seconds) {
      const m = Math.floor(seconds / 60);
      const s = seconds % 60;
      return `${m}:${s < 10 ? "0" : ""}${s}`;
    }

    function setCookie(name, value, seconds) {
      const expires = new Date(Date.now() + seconds * 1000).toUTCString();
      document.cookie = `${name}=${value}; expires=${expires}; path=/`;
    }

    function getCookie(name) {
      const match = document.cookie.match(new RegExp("(^| )" + name + "=([^;]+)"));
      return match ? match[2] : null;
    }

    function deleteCookie(name) {
      document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
    }
  }
</script>

