        </div>
      </div>

      <div class="page__search-result"></div>
      
    </div>
  </div>
</div>

<script>
   document.addEventListener('DOMContentLoaded', function () {
   
    var sliderElements = document.querySelectorAll('.search-collection-slider');

    sliderElements.forEach(function(sliderElement, index) {
      new Swiper(sliderElement, {
        loop: false,
        spaceBetween: 24,
        slidesPerView: 4.5,
        breakpoints: {
          990: {
            slidesPerView: 4.5,
          },
          750: {
            slidesPerView: 2.5,
            spaceBetween: 15,
          },
          0: {
            slidesPerView: 2.5,
          },
        },
        direction: 'horizontal',
      });
    });
  });
</script>
