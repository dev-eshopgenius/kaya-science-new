<!-- Skin Quiz HTML Markup -->

<div class="skin-quiz__section-wrapper col-custom__quiz-section">
  <div class="col-custom__content-wrap">
    <div class="skin-quiz__content-wrapper">

      <div class="skin-multiType__data-wrapper main-data-wrapper">
        <span>For</span>
        <div class="skin-type__content-wrapp selected-data-content">
          <div class="dropdown-heading">{{ settings.skin_heading1 }}</div>
          <ul class="js_col_label skin-type-data type-data-content" style="display:none;">
            {% for i in (1..5) %}
              {% capture col_label %}col_label{{ i }}{% endcapture %}
              {% capture col_trigger %}col_trigger{{ i }}{% endcapture %}
              {% if settings[col_label] != blank %}
                <li data-value="{{ settings[col_trigger] | handle }}" data-group-name="{{ settings[col_label] }}">{{ settings[col_label] }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>

      <div class="skin-productType__data-wrapper main-data-wrapper">
        <span>I'm looking for</span>
        <div class="product-type__content-wrapp selected-data-content">
          {% if settings.skin_heading2 != blank %}
          <div class="dropdown-heading">{{ settings.skin_heading2 }}</div>
          {% endif %}
          <ul id="product-type-select" class="js_col_list product-type-data type-data-content" style="display:none;">
            <li value="any-product" data-value="any-product" data-group="all">Any Product</li>
            {% for i in (1..5) %}
              {% capture col_listing %}col_list{{ i }}{% endcapture %}
              {% capture label_key %}col_trigger{{ i }}{% endcapture %}
              {% assign group_label_raw = settings[label_key] %}
              {% assign group_label = group_label_raw | handle %}

              {% for collection in settings[col_listing] %}
                {% assign coll_obj = collections[collection.handle] %}
                {% if coll_obj %}
                  {% assign quiz_text = coll_obj.metafields.custom.skin_quiz_text.value %}
                  {% if quiz_text != blank %}
                    <li value="{{ coll_obj.handle }}" data-value="{{ quiz_text | handle }}" data-group="{{ group_label }}">
                      {{ quiz_text }}
                    </li>
                  {% else %}
                    <li value="{{ coll_obj.handle }}" data-value="{{ coll_obj.handle }}" data-group="{{ group_label }}">
                      {{ coll_obj.title }}
                    </li>
                  {% endif %}
                {% endif %}
              {% endfor %}
            {% endfor %}
          </ul>
        </div>
      </div>

      <div class="skin-concern__data-wrapper main-data-wrapper">
        <span>that targets</span>
        <div class="concern-type__content-wrapp selected-data-content">
          <div class="dropdown-heading">{{ settings.skin_heading3 }}</div>
          <ul id="product-concern-select" class="js_concern_list concern-type-data type-data-content" style="display:none;">
          </ul>
        </div>
      </div>

      {% if settings.search_btn_label != blank %}
      <div class="search_btn_label_wrapp">
        <div class="button js-search-products ">{{ settings.search_btn_label }}</div>
      </div>
      {% endif %}

    </div>
  </div>
</div>

